library(ResourceSelection) # for hosmer-lemeshow test
library(car) #for multicollinearity
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: Table 1
table_1 <- dekaf %>%
dplyr::select(pid, dgf, wit_unidist, daysondial, wtkg_donor, bmi_base)
table_1
# Chunk 5: 2x2 table - use epiDisplay (more easy)
matrix_table <- cc(dekaf$dgf, dekaf$gender, graph = FALSE)
matrix_table
# Chunk 6: Logistic Regression Model by Gender
log_model <- glm(data = dekaf, dgf ~ gender, family = "binomial")
summary(log_model)
# Chunk 7: logistic regresion model - DGF by days on dialysis
log_model_2 <- glm(data = dekaf, dgf ~ daysondial, family = "binomial")
summary(log_model_2)
# Chunk 8: Confidence Interval of Odds Ratio
exp(confint(log_model_2))
# Chunk 9: data cleaning
dekaf <- dekaf %>%
mutate(transfusions = if_else(transfusions_yn == 1, "Transfusion", "No Transfusion", missing = NULL))
# Chunk 10: logistic regression model - adjusted for transfusions prior to transplant
log_model_2_adjusted <- glm(data = dekaf, dgf ~ daysondial*transfusions, family = "binomial")
summary(log_model_2_adjusted)
# Chunk 11: Use tidy function from broom package to make things tidy!
# tidy the adjusted log model
tidy_log_model_2_adjusted <- tidy(log_model_2_adjusted, conf.int = TRUE, exponentiate = TRUE)
tidy_log_model_2_adjusted
# Chunk 12: export tidy adjusted log model into a clean excel file for hw purposes
write_xlsx(tidy_log_model_2_adjusted, "DGF_adjusted_model.xlsx")
# Chunk 13: q30 - use predict function and new data frame
q30 <- data.frame(daysondial = 30, transfusions = "Transfusion")
q30_log_odds <- exp(predict(log_model_2_adjusted, newdata = q30, type = "link"))
q30_log_odds
# Chunk 14: q31 - use predict function again
q31 <- data.frame(daysondial = 30, transfusions = "No Transfusion")
q31_log_odds <- exp(predict(log_model_2_adjusted, newdata = q31, type = "link"))
q31_log_odds
# Chunk 15: odds ratio transfusion
odds_ratio_transfusion <- (q30_log_odds / q31_log_odds)
odds_ratio_transfusion
# Chunk 16: adjusted odds ratio estimate calculation
log_model_adj_final <- glm(data = dekaf,
dgf ~ transfusions*daysondial,
family = "binomial")
log_model_adj_final
# Chunk 17: tidy adjusted odds-ratio model
tidy_final <- tidy(log_model_adj_final,
conf.int = TRUE,
exponentiate = TRUE)
tidy_final
# Chunk 18: adjusted odds-ratio daysondial*transfusions
log_model_adj_day_trans <- glm(
data = dekaf,
dgf ~ daysondial*transfusions,
family = "binomial"
)
log_model_adj_day_trans
# Chunk 19: tidy log_model_adj_day_trans
tidy_adj_model_day_trans <- tidy(log_model_adj_day_trans,
conf.int = TRUE,
exponentiate = TRUE)
tidy_adj_model_day_trans
# Chunk 20: LINE model diagnostic for logistic regression
par(mfrow = c(2,2))
plot(log_model_adj_day_trans)
# Chunk 21: Hosmer-Lemeshow goodness-of-fit
hoslem.test(dekaf$dgf, fitted(log_model_adj_day_trans))
# Chunk 22: multicollinearity
vif(log_model_adj_day_trans)
# Chunk 1: load library
library(tidyverse)
library(broom) #for aesthetic clean tables
library(flextable) # export tables
library(ResourceSelection) # for hosmer-lemeshow test
library(car) #for multicollinearity
library(gtsummary)
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: create Cardiac Death variable
dekaf <- dekaf %>%
mutate(cardiac_death = if_else(dcd_yn == 1, "Yes", "No", missing = NULL),
DGF = if_else(dgf == 1, "Yes", "No", missing = NULL))
# Chunk 5: table 1 - data cleaning
table_1 <-dekaf %>%
mutate(Race = if_else(raceblack == 1, "African American", "Other", missing = NULL),
Gender = if_else(gender == 1, "Male", "Female", missing = NULL),
Delayed_Graft_Function = if_else(dgf == 1, "Yes", "No", missing = NULL)) %>%
select(Race, Gender, Delayed_Graft_Function, cardiac_death)
# Chunk 6: table 1 - table summary
table_1 <- table_1 %>%
tbl_summary(by = Delayed_Graft_Function,
label = list(cardiac_death ~ "Donation After Cardiac Death")) %>%
modify_caption(caption = "**Table 1. Participant Demographics**") %>%
modify_header(label ~ "**Delayed Graft Function**") %>%
add_overall()
## gender, race, cardiac after death
table_1
table_1 %>%
as_flex_table() %>%
save_as_docx(path = "C:/Users/Lenovo/OneDrive/Documents/githubb/biostats/Biostats 2/Exports/Table_1_Week6.docx")
ggplot(dekaf, aes(x = DGF, y = agedonor16, fill = DGF)) +
geom_boxplot() +
labs(fill = "Delayed Graft Function",
x = "",
y = "Donor Age",
title = "Figure 1. Distribution of Donor Age and Delayed Graft Function",
subtitle = "Donor age refers to years beyond 16 (i.e. 17=1)")
