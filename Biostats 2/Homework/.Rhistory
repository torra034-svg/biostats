# Chunk 11: rq1 exponentiated
tidy_rq1 <- tidy(rq1,
conf.int = TRUE,
exponentiate = TRUE)
tidy_rq1
# Chunk 12: tidy_rq1 export
tidy_rq1 %>%
write.csv(file = "C:/Users/Lenovo/OneDrive/Documents/githubb/biostats/Biostats 2/Exports/HW4/Table2.csv")
# Chunk 13: logistic regression model - cardiac death*donor age
rq2 <- glm(data = dekaf,
dgf ~ agedonor16*cardiac_death,
family = "binomial")
summary(rq2)
# Chunk 14: rq2 exponentiated
tidy_rq2 <- tidy(rq2,
conf.int = TRUE,
exponentiate = TRUE) %>%
mutate(across(where(is.numeric), ~ round(.x, 2))) %>%
mutate(conf_interval = paste0("(", conf.low, ", ", conf.high, ")")) %>%
select(term, estimate, std.error, conf_interval, p.value)
tidy_rq2
# Chunk 15: tidy_rq2 export
tidy_rq2 %>%
write.csv(file = "C:/Users/Lenovo/OneDrive/Documents/githubb/biostats/Biostats 2/Exports/HW4/Table3.csv", row.names = FALSE)
