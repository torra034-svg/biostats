# Chunk 1: load library
library(epiDisplay)
library(tidyverse)
library(broom)
library(writexl)
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: Table 1
table_1 <- dekaf %>%
dplyr::select(pid, dgf, wit_unidist, daysondial, wtkg_donor, bmi_base)
table_1
# Chunk 5: 2x2 table - use epiDisplay (more easy)
matrix_table <- cc(dekaf$dgf, dekaf$gender, graph = FALSE)
matrix_table
# Chunk 6: Logistic Regression Model by Gender
log_model <- glm(data = dekaf, dgf ~ gender, family = "binomial")
summary(log_model)
# Chunk 7: logistic regresion model - DGF by days on dialysis
log_model_2 <- glm(data = dekaf, dgf ~ daysondial, family = "binomial")
summary(log_model_2)
# Chunk 8: Confidence Interval of Odds Ratio
exp(confint(log_model_2))
# Chunk 9: data cleaning
dekaf <- dekaf %>%
mutate(transfusions = if_else(transfusions_yn == 1, "Transfusion", "No Transfusion", missing = NULL))
# Chunk 10: logistic regression model - adjusted for transfusions prior to transplant
log_model_2_adjusted <- glm(data = dekaf, dgf ~ daysondial*transfusions, family = "binomial")
summary(log_model_2_adjusted)
# Chunk 11: Use tidy function from broom package to make things tidy!
# tidy the adjusted log model
tidy_log_model_2_adjusted <- tidy(log_model_2_adjusted, conf.int = TRUE, exponentiate = TRUE)
tidy_log_model_2_adjusted
# Chunk 12: export tidy adjusted log model into a clean excel file for hw purposes
write_xlsx(tidy_log_model_2_adjusted, "DGF_adjusted_model.xlsx")
# Chunk 13: q30 - use predict function and new data frame
q30 <- data.frame(daysondial = 30, transfusions = "Transfusion")
q30_log_odds <- exp(predict(log_model_2_adjusted, newdata = q30, type = "link"))
q30_log_odds
# Chunk 14: q31 - use predict function again
q31 <- data.frame(daysondial = 30, transfusions = "No Transfusion")
q31_log_odds <- exp(predict(log_model_2_adjusted, newdata = q31, type = "link"))
q31_log_odds
q30 <- data.frame(daysondial = 30, transfusions = "Transfusion")
q30_log_odds <- exp(predict(log_model_2_adjusted, newdata = q30, type = "link"))
q30_log_odds
q31 <- data.frame(daysondial = 30, transfusions = "No Transfusion")
q31_log_odds <- exp(predict(log_model_2_adjusted, newdata = q31, type = "link"))
q31_log_odds
calculated_odds <- (q30 / q31)
calculated_odds <- (q30_log_odds / q31_log_odds)
calculated_odds
rm(calculated_odds)
odds_ratio_transfusion <- (q30_log_odds / q31_log_odds)
odds_ratio_transfusion
