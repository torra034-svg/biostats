#| label: model-1-Eversmk-vs-Ql12_4-adj-age
#| warning: false
#| message: false
#| echo: true
model_1 <- vglm(
formula = Ql12_4 ~ Eversmk + age,
data = tomhs,
family = cumulative(link = "logitlink", parallel = TRUE)
)
model_1
#| label: tbl-model-1-log
#| tbl-cap: "The Effect of Ever Smoke on Satisfaction after Adjusting for Age [log]"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_1 %>%
tbl_regression(
intercept = TRUE,
exponentiate = TRUE
)
