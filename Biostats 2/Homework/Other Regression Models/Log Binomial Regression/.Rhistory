library(tidyverse)
library(epiR) ## Make 2x2 tables
library(gtsummary) ## convert results into table
library(broom) ## convert baseR results into tibbles
# Chunk 2: load data
#| label: load data
#| warning: false
#| message: false
#| echo: false
dekaf_dgf <- read.csv("dekaf_dgf (1).csv")
# Chunk 3: tbl-gender-dgf
#| label: tbl-gender-dgf
#| tbl-cap: "2x2 Table: Gender by DGF"
#| tbl-cap-location: top
table_gender_dgf <- dekaf_dgf %>%
tbl_cross(
row = gender,
col = dgf,
label = list(gender ~ "Gender",
dgf ~ "DGF Status")) %>%
bold_labels()
table_gender_dgf
#| label: dekaf-dgf-df-clean
dekaf_dgf <- dekaf_dgf %>%
mutate(Gender = if_else(gender == 1, "Male", "Female"),
DGF = if_else(dgf == 1, "Yes DGF", "No DGF")
)
#| label: tbl-gender-dgf
#| tbl-cap: "2x2 Table: Gender by DGF"
#| tbl-cap-location: top
table_gender_dgf <- dekaf_dgf %>%
tbl_cross(
row = Gender,
col = DGF,
label = list(gender ~ "Gender",
dgf ~ "DGF Status")) %>%
bold_labels()
#| label: tbl-gender-dgf
#| tbl-cap: "2x2 Table: Gender by DGF"
#| tbl-cap-location: top
table_gender_dgf <- dekaf_dgf %>%
tbl_cross(
row = Gender,
col = DGF) %>%
bold_labels()
table_gender_dgf
#| label: dekaf-dgf-df-clean
dekaf_dgf <- dekaf_dgf %>%
mutate(Gender = if_else(gender == 1, "Male", "Female"),
DGF = if_else(dgf == 1, "Yes", "No")
)
#| label: tbl-gender-dgf
#| tbl-cap: "2x2 Table: Gender by DGF"
#| tbl-cap-location: top
table_gender_dgf <- dekaf_dgf %>%
tbl_cross(
row = Gender,
col = DGF) %>%
bold_labels()
table_gender_dgf
#| label: tbl-gender-dgf-odds-ratio
#| tbl-cap: "2x2 Table: Gender by DGF Odds-Ratio"
#| tbl-cap-location: top
dekaf_dgf %>%
select(Gender, DGF) %>%
tbl_uvregression(
method = glm,
y = DGF,
method.args = list(family = binomial),
exponentiate = TRUE
) %>%
bold_labels() %>%
italicize_levels()
#| label: tbl-gender-dgf-odds-ratio
#| tbl-cap: "2x2 Table: Gender by DGF Odds-Ratio"
#| tbl-cap-location: top
dekaf_dgf %>%
dplyr::select(Gender, DGF) %>%
tbl_uvregression(
method = glm,
y = DGF,
method.args = list(family = binomial),
exponentiate = TRUE
) %>%
bold_labels() %>%
italicize_levels()
