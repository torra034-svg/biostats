library(tidyverse)
library(epitools) ## Make 2x2 tables
library(gtsummary) ## convert results into table
library(broom) ## convert baseR results into tibbles
library(tidymodels) ## generate log models via tidyverse
library(emmeans) ## calculate ratios (e.g risk ratio)
library(gt) ## convert results to table
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_2_risks <- emmeans(model_2$fit, specs = ~ Gender_women_ref, type = "response")
model_2_risks
model_2_risks_tbl <- model_2_risks %>%
gt()
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_2_risks <- emmeans(model_2$fit, specs = ~ Gender_women_ref, type = "response")
model_2_risks %>%
as.data.frame() %>%
gt()
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_2_risks <- emmeans(model_2$fit, specs = ~ Gender_women_ref, type = "response")
model_2_risks %>%
as.data.frame() %>%
gt() %>%
tab_header(
title = "Model 2: Predicted DGF Risk",
subtitle = "Analysis of Risks by Gender"
)
model_2_risks %>%
as.data.frame() %>%
kable()
library(kableExtra)
model_2_risks %>%
as.data.frame() %>%
kable()
model_2_risks %>%
as.data.frame() %>%
kable()
model_2_risks %>%
as.data.frame() %>%
kable(
format = "html"
)
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_2_risks <- emmeans(model_2$fit, specs = ~ Gender_women_ref, type = "response")
model_2_risks %>%
as.data.frame() %>%
gt() %>%
tab_header(
title = "Model 2: Predicted DGF Risk",
subtitle = "Analysis of Risks by Gender"
) %>%
cols_label(
Gender_women_ref = "Gender",
prob = "Risk Estimate",
lower.CL = "Lower 95% CI",
upper.CL = "Upper 95% CI"
)
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_2_risks <- emmeans(model_2$fit, specs = ~ Gender_women_ref, type = "response")
model_2_risks %>%
as.data.frame() %>%
gt() %>%
tab_header(
title = "Model 2: Predicted DGF Risk",
subtitle = "Analysis of Risks by Gender"
) %>%
cols_label(
Gender_women_ref = "Gender",
prob = "Risk Estimate",
asymp.LCL	 = "Lower 95% CI",
asymp.UCL = "Upper 95% CI"
)
#| label: tbl-model-2-risks-calculations-automated
#| tbl-cap: "Model 2 Relative Risk Calculations"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
