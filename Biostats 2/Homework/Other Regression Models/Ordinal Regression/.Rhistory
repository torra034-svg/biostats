# Chunk 1: library
#| label: library
#| message: false
#| warning: false
#| echo: true
library(tidyverse)
library(gtsummary) ## make table 1
library(psych) ## descriptive stats for table 2
library(broom) ## clean object output
library(kableExtra) ## convert object outputs into table
library(stringr)
library(tidymodels)
library(multilevelmod) ## tidymodels extension for proportional_odds
library(latex2exp) ## write latex equations in plots and tables
library(jtools) ## needed for ordinal regression calculation
library(VGAM) ## needed for ordinal regression calculation
# Chunk 2: load data
#| label: load data
#| message: false
#| warning: false
#| echo: false
tomhs <- read.csv("tomhs (2).csv")
# Chunk 3: df-clean
#| label: df-clean
#| warning: false
#| message: false
#| echo: true
tomhs <- tomhs %>%
mutate(
Sex = as.factor(if_else(sex == 1, "Male", "Female")),
Race = as.factor(case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Other"
)),
Eversmk = as.factor(if_else(eversmk == 1, "Yes", "No")),
GenHealth = as.factor(case_when(
ql12_1 == 1 ~ "Excellent",
ql12_1 == 2 ~ "Very good",
ql12_1 == 3 ~ "Good",
ql12_1 == 4 ~ "Fair",
ql12_1 == 5 ~ "Poor"
)
)
)
tomhs <- tomhs %>%
mutate(GenHealth = ordered(fct_relevel(GenHealth,
"Excellent",
"Very good",
"Good",
"Fair",
"Poor"
)))
# Chunk 4: tbl-pt-demographic
#| label: tbl-pt-demographic
#| tbl-cap: "Participant Demographics by Ever Smoke Status"
#| tbl-cap-location: top
tbl_1 <- tomhs %>%
select(age, Sex, Race, Eversmk, GenHealth) %>%
tbl_summary(
by = Eversmk,
label = list(
Eversmk = "Ever Smoke",
age = "Age",
GenHealth = "General Health"
)
) %>%
add_overall() %>%
bold_labels() %>%
italicize_levels()
tbl_1
# Chunk 5: tbl-gen-health-var
#| label: tbl-gen-health-var
#| tbl-cap: "General Health Variable Summary"
#| tbl-cap-location: top
tbl_2 <- tomhs %>%
select(ql12_1) %>%
describe(IQR = TRUE) %>%
as.data.frame() %>%
select(-trimmed) %>%
kable(digits = 2,
col.names = tools::toTitleCase(names(.)),
align = "c") %>%
kable_styling(
bootstrap_options = c("striped","hover","condensed"),
full_width = FALSE,
position = "center")
tbl_2
# Chunk 6: fig-gen-health-distribution
#| label: fig-gen-health-distribution
#| fig-cap: "General Health Variable Distribution"
#| fig-cap-location: top
ggplot(tomhs,aes(x = GenHealth)) +
geom_bar() +
labs(
x = "General Health Status",
y = "Count",
title = "General Health Status Count"
)
# Chunk 7: tbl-gen-health-category-count
#| label: tbl-gen-health-category-count
#| tbl-cap: "General Health Category Count"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
tbl_3 <- tomhs %>%
select(GenHealth) %>%
group_by(GenHealth) %>%
summarize(Count = n()) %>%
arrange(GenHealth) %>%
kable(col.names = c("General Health", "Count")) %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE,
position = "center"
)
tbl_3
# Chunk 8: fig-genhealth-vs-eversmk
#| label: fig-genhealth-vs-eversmk
#| fig-cap: "General Health by Ever Smoke Status"
#| fig-cap-location: top
#| warning: false
#| message: false
#| echo: true
ggplot(tomhs, aes(x = GenHealth, fill = Eversmk)) +
geom_bar() +
labs(
x = "General Health Status",
y = "Count",
fill = "Ever Smoke Status",
title = "General Health Status by Ever Smoke Status"
)
# Chunk 9: ordinal-reg-model-building
#| label: ordinal-reg-model-building
#| warning: false
#| message: false
#| echo: true
model_1 <- vglm(
formula = GenHealth ~ Eversmk + age,
data = tomhs,
family = cumulative(link = "logitlink", parallel = TRUE))
model_1
# Chunk 10: tbl-ord-reg-output
