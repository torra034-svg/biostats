#| label: load data
#| message: false
#| warning: false
#| echo: false
tomhs <- read.csv("tomhs (2).csv")
#| label: library
#| message: false
#| warning: false
#| echo: false
library(tidyverse)
#| label: df-clean
#| warning: false
#| message: false
#| echo: true
tomhs <- tomhs %>%
mutate(
Sex = if_else(sex == 1, "Male", "Female"),
Race = case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Other"
),
Eversmk = if_else(eversmk == 1, "Yes", "No")
)
#| label: library
#| message: false
#| warning: false
#| echo: false
library(tidyverse)
library(gt) ## make table 1
#| label: library
#| message: false
#| warning: false
#| echo: false
library(tidyverse)
library(gtsummary) ## make table 1
#| label: tbl-pt-demographic
#| tbl-cap: "Particpant Demographics"
#| tbl-cap-location: top
tbl_1 <- tomhs %>%
select(age, Sex, Race, Eversmk) %>%
tbl_summary()
#| label: tbl-pt-demographic
#| tbl-cap: "Particpant Demographics"
#| tbl-cap-location: top
tbl_1 <- tomhs %>%
select(age, Sex, Race, Eversmk) %>%
tbl_summary()
tbl_1
#| label: tbl-pt-demographic
#| tbl-cap: "Particpant Demographics"
#| tbl-cap-location: top
tbl_1 <- tomhs %>%
select(age, Sex, Race, educ, Eversmk) %>%
tbl_summary(
by = Eversmk,
label = list(
Eversmk = "Ever Smoke",
age = "Age",
educ = "Education"
)
)
tbl_1
#| label: tbl-pt-demographic
#| tbl-cap: "Particpant Demographics"
#| tbl-cap-location: top
tbl_1 <- tomhs %>%
select(age, Sex, Race, educ, Eversmk) %>%
tbl_summary(
by = Eversmk,
label = list(
Eversmk = "Ever Smoke",
age = "Age",
educ = "Education"
)
) %>%
bold_labels() %>%
italicize_levels()
tbl_1
