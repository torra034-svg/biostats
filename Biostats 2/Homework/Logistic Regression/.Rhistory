library(car) #for multicollinearity and linearity
library(gtsummary)
library(performance) # Diagnostic plots for logistic regression
library(see)
library(DHARMa) #Makes it easier to see QQ plot
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: create Cardiac Death variable
dekaf <- dekaf %>%
mutate(cardiac_death = if_else(dcd_yn == 1, "Yes", "No", missing = NULL),
DGF = if_else(dgf == 1, "Yes", "No", missing = NULL))
# Chunk 5: table 1 - data cleaning
table_1 <-dekaf %>%
mutate(Race = if_else(raceblack == 1, "African American", "Other", missing = NULL),
Gender = if_else(gender == 1, "Male", "Female", missing = NULL),
Delayed_Graft_Function = if_else(dgf == 1, "Yes", "No", missing = NULL)) %>%
dplyr::select(Race, Gender, Delayed_Graft_Function, cardiac_death)
# Chunk 6: table 1 - table summary
table_1 <- table_1 %>%
tbl_summary(by = Delayed_Graft_Function,
label = list(cardiac_death ~ "Donation After Cardiac Death")) %>%
modify_caption(caption = "**Table 1. Participant Demographics**") %>%
modify_header(label ~ "**Delayed Graft Function**") %>%
add_overall()
## gender, race, cardiac after death
table_1
# Chunk 8: graph summary of donor age vs DGF
ggplot(dekaf, aes(x = DGF, y = agedonor16, fill = DGF)) +
geom_boxplot() +
labs(fill = "Delayed Graft Function",
x = "",
y = "Donor Age",
title = "Figure 1. Distribution of Donor Age and Delayed Graft Function",
subtitle = "Donor age refers to years beyond 16 (i.e. 17=1)")
# Chunk 9: graph summary of Cardiac Death vs DGF
ggplot(dekaf, aes(fill = DGF, x = cardiac_death)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(x = "Donation after Cardiac Death",
y = "Percentage",
fill = "Delayed Graft Function",
title = "Figure 2. Proportion of Delayed Graft Function by Cardiac Death Donation Status")
# Chunk 10: logistic regression model - cardiac death * donor age
rq1 <- glm(data = dekaf,
dgf ~ cardiac_death + agedonor16,
family = "binomial")
summary(rq1)
# Chunk 11: rq1 exponentiated
tidy_rq1 <- tidy(rq1,
conf.int = TRUE,
exponentiate = TRUE) %>%
mutate(across(where(is.numeric), ~ round(.x, 2))) %>%
mutate(conf_interval = paste0("(", conf.low, ", ", conf.high, ")")) %>%
dplyr::select(term, estimate, std.error, conf_interval, p.value)
tidy_rq1
# Chunk 13: logistic regression model - cardiac death*donor age
rq2 <- glm(data = dekaf,
dgf ~ agedonor16 + cardiac_death,
family = "binomial")
summary(rq2)
# Chunk 14: rq2 exponentiated
tidy_rq2 <- tidy(rq2,
conf.int = TRUE,
exponentiate = TRUE) %>%
mutate(across(where(is.numeric), ~ round(.x, 2))) %>%
mutate(conf_interval = paste0("(", conf.low, ", ", conf.high, ")")) %>%
dplyr::select(term, estimate, std.error, conf_interval, p.value)
tidy_rq2
# Chunk 16: rq1 diagnostic plots
check_model(rq1)
# Chunk 17: rq1 hoslem.test
hoslem.test(dekaf$dgf, fitted(rq1))
# Chunk 18: rq2 diagnostic plots
check_model(rq2)
# Chunk 19: rq2 hoslem.test
hoslem.test(dekaf$dgf, fitted(rq2))
# Chunk 1: load library
library(tidyverse)
library(broom) #for aesthetic clean tables
library(flextable) # export tables
library(ResourceSelection) # for hosmer-lemeshow test
library(car) #for multicollinearity and linearity
library(gtsummary)
library(performance) # Diagnostic plots for logistic regression
library(see)
library(DHARMa) #Makes it easier to see QQ plot
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: create Cardiac Death variable
dekaf <- dekaf %>%
mutate(cardiac_death = if_else(dcd_yn == 1, "Yes", "No", missing = NULL),
DGF = if_else(dgf == 1, "Yes", "No", missing = NULL))
# Chunk 5: table 1 - data cleaning
table_1 <-dekaf %>%
mutate(Race = if_else(raceblack == 1, "African American", "Other", missing = NULL),
Gender = if_else(gender == 1, "Male", "Female", missing = NULL),
Delayed_Graft_Function = if_else(dgf == 1, "Yes", "No", missing = NULL)) %>%
dplyr::select(Race, Gender, Delayed_Graft_Function, cardiac_death)
# Chunk 6: table 1 - table summary
table_1 <- table_1 %>%
tbl_summary(by = Delayed_Graft_Function,
label = list(cardiac_death ~ "Donation After Cardiac Death")) %>%
modify_caption(caption = "**Table 1. Participant Demographics**") %>%
modify_header(label ~ "**Delayed Graft Function**") %>%
add_overall()
## gender, race, cardiac after death
table_1
# Chunk 8: graph summary of donor age vs DGF
ggplot(dekaf, aes(x = DGF, y = agedonor16, fill = DGF)) +
geom_boxplot() +
labs(fill = "Delayed Graft Function",
x = "",
y = "Donor Age",
title = "Figure 1. Distribution of Donor Age and Delayed Graft Function",
subtitle = "Donor age refers to years beyond 16 (i.e. 17=1)")
# Chunk 9: graph summary of Cardiac Death vs DGF
ggplot(dekaf, aes(fill = DGF, x = cardiac_death)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(x = "Donation after Cardiac Death",
y = "Percentage",
fill = "Delayed Graft Function",
title = "Figure 2. Proportion of Delayed Graft Function by Cardiac Death Donation Status")
# Chunk 10: logistic regression model - cardiac death + donor age
rq1 <- glm(data = dekaf,
dgf ~ as.factor(cardiac_death) + agedonor16,
family = binomial(link = "logit"))
# Chunk 11: rq1 odds-ratio calculation
summ(rq1, confint = TRUE, ci.width = 0.95, digits = 4, exp = TRUE)
# Chunk 12: rq1 exponentiated
tidy_rq1 <- tidy(rq1,
conf.int = TRUE,
exponentiate = TRUE) %>%
mutate(across(where(is.numeric), ~ round(.x, 2))) %>%
mutate(conf_interval = paste0("(", conf.low, ", ", conf.high, ")")) %>%
dplyr::select(term, estimate, std.error, conf_interval, p.value)
tidy_rq1
# Chunk 14: logistic regression model - cardiac death + donor age
rq2 <- glm(data = dekaf,
dgf ~ agedonor16 + as.factor(cardiac_death),
family = binomial(link = "logit"))
# Chunk 15: rq2 summ
summ(rq2, confint = TRUE, ci.width = 0.95. digits = 4, exp = TRUE)
