#| label: data-cln-fh
fh <- fh %>%
mutate(followupYR = followup / 365.25,
CHD = as.factor(if_else(chdfate == 1, "Developed CHD", "No CHD")),
Sex = as.factor(if_else(sex == 1, "Male", "Female")),
Sex_women_ref = fct_relevel(Sex, "Female"))
#| label: sex-chd-ir
#| warning: false
#| message: false
#| echo: true
model_3 <- glm(CHD ~ Sex_women_ref,
data = fh,
family = poisson(link = "log"))
#| label: sex-chd-ir
#| warning: false
#| message: false
#| echo: true
model_3 <- glm(chdfate ~ Sex_women_ref,
data = fh,
family = poisson(link = "log"))
model_3
#| label: tbl-model-3
#| tbl-cap: "Poisson Regression Model: Sex on Coronary Heart DiseaseIncidence Rate"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_3 <- glm(chdfate ~ Sex_women_ref,
data = fh,
family = poisson(link = "log")) %>%
tbl_regression(
exponentiate = TRUE
)
model_3
#| label: tbl-model-3
#| tbl-cap: "Poisson Regression Model: Sex on Coronary Heart DiseaseIncidence Rate"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
model_3 <- glm(chdfate ~ Sex_women_ref,
data = fh,
family = poisson(link = "log")) %>%
tbl_regression(
exponentiate = TRUE,
label = list(Sex_women_ref ~ "Sex"))
model_3
