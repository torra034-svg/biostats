# Chunk 8: tbl-trt-group-vs-cigs5
#| label: tbl-trt-group-vs-cigs5
#| tbl-cap: "Poission Regression Model: The Effect of Treatment Group on Cigarette Smoking at 5 Years"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
trt_group_cigs5_model <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = poisson(link = "log"))
trt_group_cigs5_model
trt_group_cigs5_model %>% ## this is the exponentiated form
tbl_regression(
exponentiate = TRUE,
label = list(TreatmentGroup ~ "Treatment Group")
)
trt_group_cigs5_model %>% ## this is the expected log form
tbl_regression(
exponentiate = FALSE,
label = list(TreatmentGroup ~ "Treatment Group")
)
1-.67
#| label: tbl-overdispersion-test
#| tbl-cap: "Overdispersion Test"
#| tbl-cap-location: top
trt_group_cigs5_model$deviance
trt_group_cigs5_model$residuals
#| label: tbl-overdispersion-test
#| tbl-cap: "Overdispersion Test"
#| tbl-cap-location: top
trt_group_cigs5_model$deviance
trt_group_cigs5_model$df.residual
#| label: tbl-overdispersion-test
#| tbl-cap: "Overdispersion Test"
#| tbl-cap-location: top
model_ratio <- (trt_group_cigs5_model$deviance
/ trt_group_cigs5_model$df.residual)
model_ratio
#| label: tbl-overdispersion-test
#| tbl-cap: "Overdispersion Test"
#| tbl-cap-location: top
model_ratio <- (trt_group_cigs5_model$deviance
/ trt_group_cigs5_model$df.residual)
model_ratio > 1
#| label: tbl-overdispersion-test
#| tbl-cap: "Overdispersion Test"
#| tbl-cap-location: top
model_ratio <- (trt_group_cigs5_model$deviance
/ trt_group_cigs5_model$df.residual)
model_ratio
model_ratio > 10
#| label: overdispersion-test-chi-squared
pchisq(trt_group_cigs5_model$deviance, trt_group_cigs5_model$df.residual, lower.tail = FALSE)
#| label: tbl-quasi-possion-regression-model
#| tbl-cap: "Quasi-Poisson Regression Model"
#| tbl-cap-location: top
model1.qp <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = quasipoisson(link = "log"))
model1.qp
model1.qp %>%  ## exponentiated form
tbl_regression(
exponentiate = TRUE,
label = (TreatmentGroup ~ "Treatment Group")
)
model1.qp %>%  ## expected log form
tbl_regression(
exponentiate = FALSE,
label = (TreatmentGroup ~ "Treatment Group")
)
