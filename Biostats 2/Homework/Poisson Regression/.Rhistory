# Chunk 1: library
#| label: library
#| message: false
#| warning: false
#| echo: true
library(tidyverse)
library(flextable) ## for table extraction
library(gtsummary) ## for making tables
library(gt) ## for making tables
library(psych) ## calculate descriptive statistics
library(knitr) ## for making tables easily from
library(janitor) ## clean tables
# Chunk 2: load data
#| label: load data
#| message: false
#| warning: false
#| echo: false
lhs <- read.csv("lhs.csv")
fh <- read.csv("Framingham_dataset.csv")
# Chunk 3: data-cln-lhs
#| label: data-cln-lhs
#| warning: false
#| message: false
#| echo: true
lhs <- lhs %>%
mutate(cigs5 = if_else(AV5CIGS == 0.5, 1.0, AV5CIGS),
Race = case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Native American",
race == 5 ~ "Other"
),
Gender = if_else(
AGENDER == "M", "Males", "Females"
),
Marital = case_when(
marital0 == 1 ~ "Never Married",
marital0 == 2 ~ "Married",
marital0 == 3 ~ "Widowed",
marital0 == 4 ~ "Separated",
marital0 == 5 ~ "Divorced"
),
TreatmentGroup = fct_relevel(alphagroup, "UC")
)
# Chunk 4: tbl-cigs5
#| label: tbl-cigs5
#| tbl-cap: "Cigs 5"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
lhs %>%
select(cigs5) %>%
filter(cigs5 == 0.5) %>%
tibble() %>%
flextable()
# Chunk 5: tbl-pt-demo
#| label: tbl-pt-demo
#| tbl-cap: "Participant Demographics and Baseline Characteristics"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
tbl_1 <- lhs %>%
select( Race,
f10cigs,
yeareduc,
age,
bmi,
alphagroup,
Gender,
Marital,
DRINKSBL,
days2ded) %>%
tbl_summary(by = alphagroup,
label = list(
"f10cigs" = "Cigarettes Per Day at Baseline",
"yeareduc" = "Years of Education",
"age" = "Age",
"bmi" = "BMI",
"DRINKSBL" = "Alcoholic Drinks per Week at Baseline",
"days2ded" = "Time (days) from baseline to death")
) %>%
add_overall() %>%
bold_labels()
tbl_1 ## I do not need to make it into a flex table because I am copy-pasting directly from the html to google docs
# Chunk 6: fig-cigs5-hist
#| label: fig-cigs5-hist
#| fig-cap: "cigs5 Histogram"
#| fig-cap-location: top
#| warning: false
#| message: false
#| echo: true
ggplot(lhs, aes(x = cigs5)) +
geom_histogram() +
labs(x = "Cigarettes Per Day at Annual Visit (Year 5)",
y = "Count",
title = "Distribution of Cigarettes Per Day at Annual Visit (Year 5)") +
theme_minimal()
# Chunk 7: tbl-cigs5-desc-stats
#| label: tbl-cigs5-desc-stats
#| tbl-cap: "cigs5 Descriptive Statistics"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
describe(lhs$cigs5)
describe(lhs$cigs5,
IQR = TRUE) %>%
as.data.frame() %>%
select(n, mean, median, IQR, sd, min, max, skew, kurtosis) %>%
flextable() %>%
colformat_double(digits = 2) %>%
theme_booktabs() %>%
autofit() %>%
bold(part = "header") %>%
set_header_labels(
Variable = "Variable",
n = "N",
mean = "Mean",
median = "Median",
sd = "Std. Dev.",
min = "Min",
max = "Max",
skew = "Skew",
kurtosis = "Kurtosis"
)
# Chunk 8: tbl-trt-group-vs-cigs5
#| label: tbl-trt-group-vs-cigs5
#| tbl-cap: "Poission Regression Model: The Effect of Treatment Group on Cigarette Smoking at 5 Years"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
trt_group_cigs5_model <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = poisson(link = "log"))
trt_group_cigs5_model
trt_group_cigs5_model %>% ## this is the exponentiated form
tbl_regression(
exponentiate = TRUE,
label = list(TreatmentGroup ~ "Treatment Group")
)
trt_group_cigs5_model %>% ## this is the expected log form
tbl_regression(
exponentiate = FALSE,
label = list(TreatmentGroup ~ "Treatment Group")
)
# Chunk 9: overdispersion-test
#| label: overdispersion-test
model_ratio <- (trt_group_cigs5_model$deviance
/ trt_group_cigs5_model$df.residual)
model_ratio
model_ratio > 10
# Chunk 10: tbl-quasi-possion-regression-model
#| label: tbl-quasi-possion-regression-model
#| tbl-cap: "Quasi-Poisson Regression Model"
#| tbl-cap-location: top
model1.qp <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = quasipoisson(link = "log"))
model1.qp
model1.qp %>%  ## exponentiated form
tbl_regression(
exponentiate = TRUE,
label = (TreatmentGroup ~ "Treatment Group")
)
model1.qp %>%  ## expected log form
tbl_regression(
exponentiate = FALSE,
label = (TreatmentGroup ~ "Treatment Group")
)
# Chunk 11: data-cln-fh
#| label: data-cln-fh
