lhs <- lhs %>%
mutate(cigs5 = if_else(AV5CIGS == 0.5, 1.0, AV5CIGS),
Race = case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Native American",
race == 5 ~ "Other"
),
Gender = if_else(
AGENDER == "M", "Males", "Females"
),
Marital = case_when(
marital0 == 1 ~ "Never Married",
marital0 == 2 ~ "Married",
marital0 == 3 ~ "Widowed",
marital0 == 4 ~ "Separated",
marital0 == 5 ~ "Divorced"
),
relevel(alphagroup, ref = "UC")
)
