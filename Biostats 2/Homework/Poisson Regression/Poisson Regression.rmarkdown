Set-up

```{r}
#| label: library
#| message: false
#| warning: false
#| echo: true

library(tidyverse)
library(flextable) ## for table extraction
library(gtsummary) ## for making tables
library(gt) ## for making tables
library(psych) ## calculate descriptive statistics
library(knitr) ## for making tables easily from
library(janitor) ## clean tables


```

```{r}
#| label: load data
#| message: false
#| warning: false
#| echo: false

lhs <- read.csv("lhs.csv")


fh <- read.csv("Framingham_dataset.csv")

```

# Section A. Count Data with Fixed Denominator (No Offset Term)

## Data Cleaning

```{r}
#| label: data-cln-lhs
#| warning: false
#| message: false
#| echo: true

lhs <- lhs %>% 
  mutate(cigs5 = if_else(AV5CIGS == 0.5, 1.0, AV5CIGS),
         Race = case_when(
           race == 1 ~ "White",
           race == 2 ~ "Black",
           race == 3 ~ "Asian",
           race == 4 ~ "Native American",
           race == 5 ~ "Other"
         ),
         Gender = if_else(
           AGENDER == "M", "Males", "Females"
         ),
        Marital = case_when(
          marital0 == 1 ~ "Never Married",
          marital0 == 2 ~ "Married",
          marital0 == 3 ~ "Widowed",
          marital0 == 4 ~ "Separated",
          marital0 == 5 ~ "Divorced"
        ),
        TreatmentGroup = fct_relevel(alphagroup, "UC")
  )
        


```

## cigs5 table

```{r}
#| label: tbl-cigs5
#| tbl-cap: "Cigs 5"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true


lhs %>% 
  select(cigs5) %>% 
  filter(cigs5 == 0.5) %>% 
  tibble() %>% 
  flextable()



```

