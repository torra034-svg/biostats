library(mosaicData)
data("Whickham")
obs <- nrow(Whickham)
variables <- ncol(Whickham)
glimpse(Whickham)
ggplot(Whickham, aes(x = outcome)) +
geom_bar()
ggplot(Whickham, aes(x = smoker)) +
geom_bar()
ggplot(Whickham, aes(x = age)) +
geom_boxplot()
ggplot(Whickham, aes(x = age)) +
geom_boxplot() +
coord_flip()
