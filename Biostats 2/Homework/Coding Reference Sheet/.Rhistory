# Chunk 1: load-packages
#install.packages("mosaicData")
library(tidyverse)
library(mosaicData)
# Chunk 2: import data and view observation count
data("Whickham")
obs <- nrow(Whickham)
# Chunk 3: view variable count
variables <- ncol(Whickham)
# Chunk 4: data visualization: smoking vs health
Whickham %>%
count(smoker, outcome) %>%
ggplot(aes(x = smoker, y = n, fill = outcome)) +
geom_col() +
labs(x = "Smoking Status",
fill = "Health Outcome",
y = "Count",
title = "Smoking Status Count by Health Outcome",
caption = "DR Appleton, JM French, MPJ Vanderpump. Ignoring a covariate: an example of Simpson's paradox. (1996) American Statistician, 50(4):340-341.")
# Chunk 5: age_cat data viz
Whickham <- Whickham %>%
mutate(age_cat = as.factor(case_when(
age <= 44 ~ "18-44",
age > 44 & age <= 64 ~ "45-64",
age > 64 ~ "65+")))
# Chunk 6: age_cat check factor
is.factor(Whickham$age_cat)
# Chunk 7: data viz faceted by age_cat
Whickham %>%
count(smoker, outcome, age_cat) %>%
ggplot(aes(x = smoker, y = n, fill = outcome)) +
geom_col() +
facet_wrap(~ age_cat) +
labs(x = "Smoking Status",
fill = "Health Outcome",
y = "Count",
title = "Smoking Status Count by Health Outcome and Age Category",
caption = "DR Appleton, JM French, MPJ Vanderpump. Ignoring a covariate: an example of Simpson's paradox. (1996) American Statistician, 50(4):340-341.")
#install.packages("mosaicData")
