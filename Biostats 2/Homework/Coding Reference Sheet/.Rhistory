# Chunk 21: lhs-import
#| label: lhs-import
#| message: false
#| warning: false
#| echo: false
#| include: false
lhs <- read.csv("lhs.csv")
lhs <- lhs %>%
mutate(cigs5 = if_else(AV5CIGS == 0.5, 1.0, AV5CIGS),
Race = case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Native American",
race == 5 ~ "Other"
),
Gender = if_else(
AGENDER == "M", "Males", "Females"
),
Marital = case_when(
marital0 == 1 ~ "Never Married",
marital0 == 2 ~ "Married",
marital0 == 3 ~ "Widowed",
marital0 == 4 ~ "Separated",
marital0 == 5 ~ "Divorced"
),
TreatmentGroup = fct_relevel(alphagroup, "UC")
)
# Chunk 22: cigs-model
#| label: cigs-model
#| message: false
#| warning: false
#| echo: true
trt_group_cigs5_model <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = poisson(link = "log"))
trt_group_cigs5_model
# Chunk 23: tbl-cigs-model-exp
#| label: tbl-cigs-model-exp
#| tbl-cap: "caption"
#| tbl-cap-location: top
#| message: false
#| warning: false
#| echo: true
trt_group_cigs5_model %>% ## this is the exponentiated form
tbl_regression(
intercept = TRUE,
exponentiate = TRUE,
label = list(TreatmentGroup ~ "Treatment Group")
)
# Chunk 24: tbl-cigs-model-log-form
#| label: tbl-cigs-model-log-form
#| tbl-cap: "caption"
#| tbl-cap-location: top
#| message: false
#| warning: false
#| echo: true
trt_group_cigs5_model %>% ## this is the expected log form
tbl_regression(
intercept = TRUE,
exponentiate = FALSE,
label = list(TreatmentGroup ~ "Treatment Group")
)
# Chunk 25: overdispersion-test
#| label: overdispersion-test
#| message: false
#| warning: false
#| echo: true
#|
model_ratio <- (trt_group_cigs5_model$deviance
/ trt_group_cigs5_model$df.residual)
model_ratio
model_ratio > 10
# Chunk 26: quasi-poisson
#| label: quasi-poisson
#| message: false
#| warning: false
#| echo: true
model1.qp <- glm(cigs5 ~ TreatmentGroup,
data = lhs,
family = quasipoisson(link = "log"))
model1.qp
# Chunk 27: quasi-poisson-exp
#| label: quasi-poisson-exp
#| message: false
#| warning: false
#| echo: true
model1.qp %>%  ## exponentiated form
tbl_regression(
exponentiate = TRUE,
label = (TreatmentGroup ~ "Treatment Group")
)
# Chunk 28: quasi-poisson-log-form
#| label: quasi-poisson-log-form
#| message: false
#| warning: false
#| echo: true
model1.qp %>%  ## expected log form
tbl_regression(
exponentiate = FALSE,
label = (TreatmentGroup ~ "Treatment Group")
)
