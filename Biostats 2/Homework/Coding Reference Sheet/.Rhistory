# Chunk 1: library
#| label: library
#| message: false
#| warning: false
#| echo: true
library(tidyverse) ## data cleaning
library(kableExtra) ## make table from output via kable()
library(gtsummary) ## make table via tbl_regression()
# Chunk 2: import-data
#| label: import-data
#| warning: false
#| message: false
#| echo: true
tomhs <- read.csv("tomhs.csv")
# Chunk 3: new-var
#| label: new-var
#| warning: false
#| message: false
#| echo: true
tomhs <- tomhs %>%
mutate(
Sex = as.factor(if_else(sex == 1, "Male", "Female")),
Race = as.factor(case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Other")
),
weight_change = wt12-wtbl,
cholesterol_change = chol12-cholbl)
# Chunk 4: delete-obs-sub-set
#| label: delete-obs-sub-set
#| warning: false
#| message: false
#| echo: true
tomhs_filter <- tomhs %>%
filter(!is.na(age))
# Chunk 5: tbl-unadj-MLR
#| label: tbl-unadj-MLR
#| tbl-cap: "Unadjusted Multiple Linear Regression"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
unadj_MLR <- lm(cholesterol_change ~ weight_change, data = tomhs)
unadj_MLR
unadj_MLR %>%
tbl_regression(
intercept = TRUE
)
# Chunk 6: tbl-Adj-MLR
#| label: tbl-Adj-MLR
#| tbl-cap: "Adjusted Multiple Linear Regression"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
adj_MLR <- lm(
formula = cholesterol_change ~ weight_change + Sex,
data = tomhs)
adj_MLR
adj_MLR %>%
tbl_regression(
intercept = TRUE
)
# Chunk 7: tomhs-data-clean
#| label: tomhs-data-clean
#| message: false
#| warning: false
#| echo: false
#| include: false
tomhs <- tomhs %>%
mutate(wtchg = wt12 - wtbl,
cholchg = chol12 - cholbl,
nowsmk1 = as.factor(if_else(nowsmk == 1, "Current Smoker", "Non-current Smoker")))
# Chunk 8: smk-interaction-model
#| label: smk-interaction-model
#| message: false
#| warning: false
#| echo: true
tomhs$nowsmk1 <-relevel(tomhs$nowsmk1, ref = "Non-current Smoker")
interaction_model <- lm(
formula = cholchg~wtchg+nowsmk1+wtchg*nowsmk1,
data = tomhs)
interaction_model
# Chunk 9: interaction-model-exp
#| label: interaction-model-exp
#| tbl-cap: "Interaction Model between Total Cholesterol Change and weight change and smoking status"
#| tbl-cap-location: top
#| message: false
#| warning: false
#| echo: true
interaction_model %>%
tbl_regression(
intercept =  TRUE
)
# Chunk 10: fig-MLR-assumptions
#| label: fig-MLR-assumptions
#| fig-cap: "MLR Assumptions"
#| fig-cap-location: top
#| warning: false
#| message: false
