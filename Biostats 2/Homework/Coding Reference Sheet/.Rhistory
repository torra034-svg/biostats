# Chunk 1: load library
library(tidyverse)
library(broom) #for aesthetic clean tables
library(flextable) # export tables
library(ResourceSelection) # for hosmer-lemeshow test
library(car) #for multicollinearity and linearity
library(gtsummary)
library(performance) # Diagnostic plots for logistic regression
library(see)
library(DHARMa) #Makes it easier to see QQ plot
library(jtools)
library(lmtest)
# Chunk 2: import data
url <- "https://raw.githubusercontent.com/torra034-svg/biostats/refs/heads/main/Biostats%202/Data%20Stuff/dekaf_dgf.csv"
dekaf <- read.csv(url)
# Chunk 3: remove url
rm(url)
# Chunk 4: create Cardiac Death variable
dekaf <- dekaf %>%
mutate(cardiac_death = if_else(dcd_yn == 1, "Yes", "No", missing = NULL),
DGF = if_else(dgf == 1, "Yes", "No", missing = NULL))
# Chunk 5: table 1 - data cleaning
table_1 <- dekaf %>%
mutate(Race = if_else(raceblack == 1, "African American", "Other", missing = NULL),
Gender = if_else(gender == 1, "Male", "Female", missing = NULL),
Delayed_Graft_Function = if_else(dgf == 1, "Yes", "No", missing = NULL)) %>%
dplyr::select(Race, Gender, Delayed_Graft_Function, cardiac_death, bmi_base, agedonor16)
# Chunk 6: table 1 - table summary
table_1 <- table_1 %>%
tbl_summary(by = Delayed_Graft_Function,
label = list(cardiac_death ~ "Donation After Cardiac Death",
bmi_base ~ "Recipient BMI at baseline (kg/m2)",
agedonor16 ~ "Donor age (years beyond 16, i.e. 17=1)"
)) %>%
modify_caption(caption = "**Table 1. Participant Demographics**") %>%
modify_header(label ~ "**Delayed Graft Function**") %>%
add_overall()
table_1
# Chunk 8: graph summary of donor age vs DGF
ggplot(dekaf, aes(x = DGF, y = agedonor16, fill = DGF)) +
geom_boxplot() +
labs(fill = "Delayed Graft Function",
x = "",
y = "Donor Age",
title = "Figure 1. Distribution of Donor Age and Delayed Graft Function",
subtitle = "Donor age refers to years beyond 16 (i.e. 17=1)")
# Chunk 9: graph summary of Cardiac Death vs DGF
ggplot(dekaf, aes(fill = DGF, x = cardiac_death)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(x = "Donation after Cardiac Death",
y = "Percentage",
fill = "Delayed Graft Function",
title = "Figure 2. Proportion of Delayed Graft Function by Cardiac Death Donation Status")
# Chunk 10: logistic regression model - cardiac death + donor age
rq1 <- glm(data = dekaf,
as.factor(dgf) ~ as.factor(cardiac_death) + agedonor16,
family = binomial(link = "logit"))
# Chunk 11: rq1 odds-ratio calculation
summ(rq1, confint = TRUE, ci.width = 0.95, digits = 4, exp = TRUE)
# Chunk 12: logistic regression model - cardiac death + donor age
rq2 <- glm(data = dekaf,
as.factor(dgf) ~ agedonor16 + as.factor(cardiac_death),
family = binomial(link = "logit"))
# Chunk 13: rq2 summ
summ(rq2, confint = TRUE, ci.width = 0.95, digits = 4, exp = TRUE)
# Chunk 14: rq1 lrtest
lrtest(rq1,rq2)
vif(rq1)
hoslem.test(dekaf$dgf, fitted(rq1))
# Chunk 15: rq1 graph prep
mydata_rq1 <- subset(dekaf, select = c(agedonor16)) ## only donor age bc this is the only continuous variable
cont_predictors <- colnames(mydata_rq1)
mydata_rq1$logit <- predict(rq1)
# Chunk 16: rq1 graph
rq1_graph <- pivot_longer(mydata_rq1, names_to = "predictors", values_to = "predictor.value", -logit) %>%
ggplot(aes(x = predictor.value, y = logit)) +
geom_point(size = 0.5, alpha = 0.5) +
geom_smooth(method = "loess", color = "blue", se = FALSE) +
geom_smooth(method = "lm", color = "red", se = FALSE) +
facet_wrap(facets = ~ predictors, scales = "free_x") +
labs(x = "Donor Age",
y = "Logit",
title = "Figure 3. Logit vs Donor Age") +
theme_bw()
rq1_graph
# Chunk 17: save graph
ggsave(filename = "rq1_graph.png", plot = rq1_graph, path = "Exports/")
# Chunk 1: library
#| label: library
#| message: false
#| warning: false
#| echo: true
library(tidyverse)
library(kableExtra)
library(gtsummary)
# Chunk 2: import-data
#| label: import-data
#| warning: false
#| message: false
#| echo: true
tomhs <- read.csv("tomhs.csv")
# Chunk 3: new-var
#| label: new-var
#| warning: false
#| message: false
#| echo: true
tomhs <- tomhs %>%
mutate(
Sex = as.factor(if_else(sex == 1, "Male", "Female")),
Race = as.factor(case_when(
race == 1 ~ "White",
race == 2 ~ "Black",
race == 3 ~ "Asian",
race == 4 ~ "Other")
),
weight_change = wt12-wtbl,
cholesterol_change = chol12-cholbl)
# Chunk 4: delete-obs-sub-set
#| label: delete-obs-sub-set
#| warning: false
#| message: false
#| echo: true
tomhs_filter <- tomhs %>%
filter(!is.na(age))
# Chunk 5: tbl-unadj-MLR
#| label: tbl-unadj-MLR
#| tbl-cap: "Unadjusted Multiple Linear Regression"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
unadj_MLR <- lm(cholesterol_change ~ weight_change, data = tomhs)
unadj_MLR
unadj_MLR %>%
tbl_regression(
intercept = TRUE
)
# Chunk 6: tbl-Adj-MLR
#| label: tbl-Adj-MLR
#| tbl-cap: "Adjusted Multiple Linear Regression"
#| tbl-cap-location: top
#| warning: false
#| message: false
#| echo: true
adj_MLR <- lm(
formula = cholesterol_change ~ weight_change + Sex,
data = tomhs)
adj_MLR
adj_MLR %>%
tbl_regression(
intercept = TRUE
)
# Chunk 7: fig-MLR-assumptions
#| label: fig-MLR-assumptions
#| fig-cap: "MLR Assumptions"
#| fig-cap-location: top
#| warning: false
#| message: false
#| echo: true
par(mfrow = c(2,2))
plot(adj_MLR)
#| label: dekaf-data-clean
#| warning: false
#| message: false
#| echo: false
dekaf <-read.csv("dekaf_dgf.csv")
dekaf <- dekaf %>%
mutate(cardiac_death = if_else(dcd_yn == 1, "Yes", "No", missing = NULL),
DGF = if_else(dgf == 1, "Yes", "No", missing = NULL))
#| label: tbl-log-reg
#| tbl-cap: "Logistic Regression Output"
#| tbl-cap-location: top
rq1 <- glm(data = dekaf,
formula = as.factor(dgf) ~ as.factor(cardiac_death) + agedonor16,
family = binomial(link = "logit"))
rq1
rq1 %>%
tbl_regression()
