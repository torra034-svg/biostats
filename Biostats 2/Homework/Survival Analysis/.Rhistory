}
# Chunk 5: find accident files in all subfolders
accident_files <- list.files(
path = raw_data_path,
pattern = "^accident\\.csv$",
recursive = TRUE,
full.names = TRUE,
ignore.case = TRUE
)
# Chunk 6: create for loop to rename each file
for (file in accident_files) {
