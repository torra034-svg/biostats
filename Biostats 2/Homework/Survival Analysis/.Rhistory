contract_percent = (contract_labor / total_dept_expenditure)*100,
total_dept_expenditure_percent = (total_dept_expenditure / total_dept_expenditure)*100) %>%
filter(total_dept_expenditure_percent > 0)
df_finance_analysis <- df_finance_v2 %>%
group_by(year) %>%
summarize(clinical_percent = (clinical_dept / total_dept_expenditure)*100,
admin_percent = (admin_dept / total_dept_expenditure)*100,
oper_percent = (oper_cost / total_dept_expenditure)*100,
contract_percent = (contract_labor / total_dept_expenditure)*100,
total_dept_expenditure_percent = (total_dept_expenditure / total_dept_expenditure)*100) %>%
filter(total_dept_expenditure_percent > 0)
rm(df_finance_analysis)
df_finance_analysis <- df_finance_v2 %>%
group_by(year) %>%
summarize(clinical_percent = (clinical_dept / total_dept_expenditure)*100,
admin_percent = (admin_dept / total_dept_expenditure)*100,
oper_percent = (oper_cost / total_dept_expenditure)*100,
contract_percent = (contract_labor / total_dept_expenditure)*100,
total_dept_expenditure_percent = (total_dept_expenditure / total_dept_expenditure)*100) %>%
filter(total_dept_expenditure_percent > 0)
View(df_finance_v2)
df_finance_analysis <- df_finance_v2 %>%
group_by(year) %>%
summarize(clinical_median_percent = median((clinical_dept / total_dept_expenditure))*100,
admin_percent = (admin_dept / total_dept_expenditure)*100,
oper_percent = (oper_cost / total_dept_expenditure)*100,
contract_percent = (contract_labor / total_dept_expenditure)*100,
total_dept_expenditure_percent = (total_dept_expenditure / total_dept_expenditure)*100) %>%
filter(total_dept_expenditure_percent > 0)
rm(df_finance_analysis)
df_finance_analysis <- df_finance_v2 %>%
group_by(year) %>%
summarize(clinical_median_percent = (clinical_dept / total_dept_expenditure)*100,
admin_percent = (admin_dept / total_dept_expenditure)*100,
oper_percent = (oper_cost / total_dept_expenditure)*100,
contract_percent = (contract_labor / total_dept_expenditure)*100,
total_dept_expenditure_percent = (total_dept_expenditure / total_dept_expenditure)*100) %>%
filter(total_dept_expenditure_percent > 0)
rm(df_finance_analysis)
df_finance_analysis <- df_finance_v2 %>%
# 1. Calculate the percentage for every individual row first
mutate(
clinical_pct = (clinical_dept / total_dept_expenditure) * 100,
admin_pct    = (admin_dept / total_dept_expenditure) * 100,
oper_pct     = (oper_cost / total_dept_expenditure) * 100,
contract_pct = (contract_labor / total_dept_expenditure) * 100
) %>%
# 2. Group by year
group_by(year) %>%
# 3. Calculate the mean of those percentages
summarize(
mean_clinical_pct = mean(clinical_pct, na.rm = TRUE),
mean_admin_pct    = mean(admin_pct, na.rm = TRUE),
mean_oper_pct     = mean(oper_pct, na.rm = TRUE),
mean_contract_pct = mean(contract_pct, na.rm = TRUE),
avg_total_expenditure = mean(total_dept_expenditure, na.rm = TRUE)
) %>%
# 4. Filter out any years where expenditure was zero
filter(avg_total_expenditure > 0)
# 1. Pivot the data to a "long" format
df_long <- df_finance_analysis %>%
select(year, mean_clinical_pct, mean_admin_pct, mean_oper_pct, mean_contract_pct) %>%
pivot_longer(
cols = starts_with("mean"),
names_to = "department",
values_to = "percentage"
)
# 2. Create the plot
ggplot(df_long, aes(x = factor(year), y = percentage, fill = department)) +
geom_bar(stat = "identity") +
theme_minimal() +
labs(
title = "Departmental Expenditure Breakdown by Year",
x = "Year",
y = "Average Percentage of Total Expenditure",
fill = "Department"
) +
scale_fill_brewer(palette = "Set2") # Makes the colors look professional
