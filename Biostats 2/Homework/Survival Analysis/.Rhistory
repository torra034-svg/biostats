year <- basename(dirname(file))
# Create new filename with year added
new_name <- paste0(year, "_accident.csv")
# Full destination path
dest_path <- file.path(dest_folder, new_name)
# Copy file
file.copy(file, dest_path, overwrite = TRUE)
}
# Chunk 7: copy files to new folder
file.copy(accident_files, dest_folder, overwrite = TRUE)
