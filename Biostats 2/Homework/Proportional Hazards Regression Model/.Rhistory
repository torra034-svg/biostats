library(tidyverse)
library(survival)
library(ggfortify) ## to calculate "Schoenfeld residuals vs time"
library(survminer)
library(multcomp)
library(emmeans) ## to calculate hazard ratios
library(gtsummary) ## to make table
library(flextable) ## export table 1 to word
# Chunk 2
f6 <- read.csv("first6.csv")
# Chunk 3
#| code-fold: true
#| code-summary: "Click here to view data cleaning code"
f6 <- f6 %>%
mutate(Gender = as.factor(if_else(GENDER == 1, "Male", "Female", missing = NULL)),
Race = as.factor(case_when(RACE == 1 ~ "Latino",
RACE == 2 ~ "African American",
RACE == 3 ~ "White",
RACE == 4 ~ "Other")),
Above200 = as.factor(if_else(above200 == 1, "Above 200 cell count", "Below 200 cell count")),
Randgrp = as.factor(case_when(RANDGRP == 1 ~ "PI + NRTI",
RANDGRP == 2 ~ "NNRTI + NRTI",
RANDGRP == 3 ~ "PI + NNRTI + NRTI")))
# Chunk 4: table-study-pop
#|label: table-study-pop
#|tbl-cap: "Table 1: Study Population"
t1 <- f6 %>%
dplyr::select(AGE, Gender, Race, Above200, Randgrp) %>%
tbl_summary(by = Randgrp,
label = list("AGE" = "Age",
"Above200" = "Cell Count")) %>%
add_overall() %>%
modify_caption("**Table 1: Study Population**")
t1
# Chunk 5: export to word
#| code-fold: true
#| code-summary: "Click here to view table 1 export"
t1 %>%
as_flex_table() %>%
save_as_docx(path = "Exports/Table_1")
#| code-fold: true
#| code-summary: "Click here to view table 1 export"
t1 %>%
as_flex_table() %>%
save_as_docx(path = "Exports/Table_1.docx")
#| code-fold: true
#| code-summary: "Click here to view data cleaning code"
f6 <- f6 %>%
mutate(Gender = as.factor(if_else(GENDER == 1, "Male", "Female", missing = NULL)),
Race = as.factor(case_when(RACE == 1 ~ "Latino",
RACE == 2 ~ "African American",
RACE == 3 ~ "White",
RACE == 4 ~ "Other")),
Above200 = as.factor(if_else(above200 == 1, "Above 200 cell count", "Below 200 cell count")),
Randgrp = as.factor(case_when(RANDGRP == 1 ~ "PI + NRTI",
RANDGRP == 2 ~ "NNRTI + NRTI",
RANDGRP == 3 ~ "PI + NNRTI + NRTI")),
twoclass = as.factor(twoclass))
AIDS_fit <- survfit(Surv(t2qoi, qoi) ~ twoclass, data = f6)
#| label: kaplan-meier-plot
#| fig-cap: "Kaplan-Meier: AIDS Survival Analysis"
autoplot(AIDS_fit) +
xlab("ASD") +
ylab("asd") +
labs(title = "asds")
#| label: kaplan-meier-plot
#| fig-cap: "Kaplan-Meier: AIDS Survival Analysis"
autoplot(AIDS_fit) +
xlab("Time (Months)") +
ylab("AIDS Survival Percentage") +
labs(title = "Time to AIDS",
subtitle = "By Treatment Type") +
theme_bw()
#| code-fold: true
#| code-summary: "Click here to view data cleaning code"
f6 <- f6 %>%
mutate(Gender = as.factor(if_else(GENDER == 1, "Male", "Female", missing = NULL)),
Race = as.factor(case_when(RACE == 1 ~ "Latino",
RACE == 2 ~ "African American",
RACE == 3 ~ "White",
RACE == 4 ~ "Other")),
Above200 = as.factor(if_else(above200 == 1, "Above 200 cell count", "Below 200 cell count")),
Randgrp = as.factor(case_when(RANDGRP == 1 ~ "PI + NRTI",
RANDGRP == 2 ~ "NNRTI + NRTI",
RANDGRP == 3 ~ "PI + NNRTI + NRTI")),
twoclass = as.factor(twoclass),
TwoClass = as.factor(case_when(twoclass == 1 ~ "Two Class",
twoclass == 2 ~ "Three Class")))
AIDS_fit <- survfit(Surv(t2qoi, qoi) ~ TwoClass, data = f6)
#| label: kaplan-meier-plot
#| fig-cap: "Kaplan-Meier: AIDS Survival Analysis"
autoplot(AIDS_fit) +
xlab("Time (Months)") +
ylab("AIDS Survival Percentage") +
labs(title = "Time to AIDS",
subtitle = "By Treatment Type") +
theme_bw()
#| label: kaplan-meier-plot
#| fig-cap: "Kaplan-Meier: AIDS Survival Analysis"
autoplot(AIDS_fit) +
xlab("Time (Months)") +
ylab("AIDS Survival Percentage") +
labs(title = "Time to AIDS",
subtitle = "By Treatment Type") +
theme_bw() +
scale_color_discrete(name = "Treatment")
#| label: kaplan-meier-plot
#| fig-cap: "Kaplan-Meier: AIDS Survival Analysis"
autoplot(AIDS_fit) +
xlab("Time (Months)") +
ylab("AIDS Survival Percentage") +
labs(title = "Time to AIDS",
subtitle = "By Treatment Type") +
theme_minimal()
