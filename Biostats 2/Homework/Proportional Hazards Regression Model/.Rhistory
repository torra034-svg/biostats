# Chunk 1: library
#| label: library
library(tidyverse)
library(survival)
library(ggfortify)
library(survminer)
# Chunk 1: library
#| label: library
library(tidyverse)
library(survival)
library(ggfortify)
library(survminer)
library(multcomp)
# Chunk 2: load dataset
#| label: load dataset
f6 <- read.csv("first6.csv")
# Chunk 3: dataclean
#| label: dataclean
f6 <- f6 %>%
mutate(twoclass = as.factor(twoclass),
primary = as.numeric(as.character(primary)))
# Chunk 4: Cox hazard model
#| label: Cox hazard model
model1 <- coxph(Surv(t2primary, primary) ~ twoclass, data = f6)
summary(model1)
# Chunk 5: Schoenfeld residuals vs time
#| label:  Schoenfeld residuals vs time
model1_resid <- cox.zph(model1)
ggcoxzph(model1_resid)
#| label: load dataset
f6 <- read.csv("first6.csv")
f6_twoclass <- read.csv("first6_twoclass.csv")
#| label: create indicator variable
f6_twoclass <- f6_twoclass %>%
mutate(agege40 = if_else(AGE >= 40, 1, 0))
ggplot(f6_twoclass, aes(x = agege40)) +
geom_boxplot()
#| label: create indicator variable
f6_twoclass <- f6_twoclass %>%
mutate(agege40 = as.factor(if_else(AGE >= 40, 1, 0)))
ggplot(f6_twoclass, aes(x = agege40)) +
geom_boxplot()
ggplot(f6_twoclass, aes(x = agege40)) +
geom_point()
ggplot(f6_twoclass, aes(x = agege40, y = primary)) +
geom_point()
ggplot(f6_twoclass, aes(x = agege40)) +
geom_bar()
ggplot(f6_twoclass, aes(x = agege40, fill = agege40)) +
geom_bar()
ggplot(f6_twoclass, aes(x = agege40, fill = agege40)) +
geom_bar() +
labs(x = NULL,
y = "Count",
title = "Age 40 Distribution") +
theme(legend.position = "none")
ggplot(f6_twoclass, aes(x = agege40, fill = agege40)) +
geom_bar() +
labs(x = NULL,
y = "Count",
title = "Age 40 Distribution")
ggplot(f6_twoclass, aes(x = agege40, fill = agege40)) +
geom_bar() +
labs(x = NULL,
y = "Count",
title = "Age Distribution: Below/Above 40 Years Old")
install.packages("bookdown")
